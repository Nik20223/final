# Шаблон локальных секретов развёртывания.
#
# Скопируйте в deploy/.env и подставьте свои значения — сам .env в .gitignore.
#
# Одно и то же значение нужно в двух местах:
#   1. Локально в deploy/.env — для скрипта jenkins-create-job.sh.
#   2. На сервере в /root/jenkins.env — оттуда его читает контейнер Jenkins,
#      подставляя в jenkins-casc.yaml вместо ${JENKINS_ADMIN_PASSWORD}.

JENKINS_ADMIN_PASSWORD=change-me
